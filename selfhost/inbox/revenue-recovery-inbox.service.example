[Unit]
Description=Revenue Recovery private enquiry inbox
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/clarence/Projects/revenue-recovery
ExecStart=/home/clarence/.local/share/revenue-recovery/runtime/node-v24.19.0-linux-x64/bin/node selfhost/inbox/server.mjs
Environment=RR_DB_PATH=/home/clarence/revenue-recovery-data/enquiries.sqlite
Environment=RR_INBOX_PORT=3089
EnvironmentFile=/home/clarence/revenue-recovery-data/inbox.env
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
